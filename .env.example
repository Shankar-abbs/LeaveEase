# Next.js public env vars (safe to expose to browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Vercel deployment
# VERCEL_TOKEN=
# VERCEL_ORG_ID=
# VERCEL_TEAM_SLUG=
# VERCEL_PROJECT_NAME=
# VERCEL_PROJECT_ID=

# Email (Resend)
# RESEND_API_KEY=
# EMAIL_FROM=LeaveEase <onboarding@resend.dev>
# EMAIL_OVERRIDE_TO=   # if set, redirects all email here

# Demo / seed
# HR_ADMIN_EMAIL=hr.admin@leaveease.test
# DEMO_USER_PASSWORD=

# Observability
# SENTRY_DSN=          # optional, skipped if blank
# LOG_LEVEL=info       # debug | info | warn | error

# App
NODE_ENV=development
NEXT_PUBLIC_APP_VERSION=local
